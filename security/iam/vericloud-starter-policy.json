{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrecheckUploads",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:HeadObject"],
      "Resource": [
        "arn:aws:s3:::vericloud-raw-1009-a/raw/id-card/*",
        "arn:aws:s3:::vericloud-raw-1009-a/raw/selfie/*"
      ]
    },
    {
      "Sid": "ConsumeIngestQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:153547984638:vericloud-ingest-queue"
    },
    {
      "Sid": "StartKycWorkflow",
      "Effect": "Allow",
      "Action": ["states:StartExecution"],
      "Resource": "arn:aws:states:us-east-1:153547984638:stateMachine:vericloud-kyc-workflow"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:153547984638:log-group:/aws/lambda/vericloud-starter:*"
    }
  ]
}
