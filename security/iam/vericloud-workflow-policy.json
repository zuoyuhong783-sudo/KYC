{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeBranchLambdas",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": [
        "arn:aws:lambda:us-east-1:153547984638:function:vericloud-ocr",
        "arn:aws:lambda:us-east-1:153547984638:function:vericloud-face"
      ]
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:153547984638:log-group:/aws/states/vericloud-kyc-workflow:*"
    }
  ]
}
